NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- Lecture text: use one setup, with a key dedicated to this app ----
#
# A. Any OpenAI-compatible provider (OpenRouter, Together, Fireworks,
#    DeepInfra, Cerebras, Hugging Face, Ollama, vLLM, LocalAI, ...)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#
# B. Named preset
# LLM_PROVIDER=groq            # groq | openai
# GROQ_API_KEY=
# OPENAI_API_KEY=

# ---- Audio narration (optional) ----
# TTS_BASE_URL=https://api.openai.com/v1
