NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Lecture text: set one of these.
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional provider/model overrides.
# LLM_PROVIDER=groq            # groq | openai (auto-detected when unset)
# LLM_MODEL=openai/gpt-oss-120b

# Stored audio narration: an OpenAI-compatible speech key.
# Groq's Orpheus TTS caps input at 200 characters and returns WAV, so it is
# not used here; without a key, the training page reads the lecture aloud.
TTS_API_KEY=
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
