NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- Lecture text: use one setup, with a key dedicated to this app ----
#
# A. Any OpenAI-compatible provider (OpenRouter, Together, Fireworks,
#    DeepInfra, Cerebras, Hugging Face, Ollama, vLLM, LocalAI, ...)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#
# B. Named preset
# LLM_PROVIDER=groq            # groq | openai
# GROQ_API_KEY=
# OPENAI_API_KEY=

# ---- Audio narration (optional) ----
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_API_KEY=
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
# TTS_FORMAT=mp3

# ---- Payments / search-cycle pass ----
# Stripe secret key. Use a test key (sk_test_...) until you go live.
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint you create for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Service role key: server-only. Used by the webhook to record purchases,
# which bypasses row-level security. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Pass prices and credit counts live in src/lib/billing/config.ts.
# PASS_CURRENCY=usd
NEXT_PUBLIC_SITE_URL=https://www.jaydi.fit
